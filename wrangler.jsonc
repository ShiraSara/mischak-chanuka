{
  "name": "seker-game",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/yemot", "/yemot/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "seker-game-db", "database_id": "local-dev-placeholder" }
  ]
}
