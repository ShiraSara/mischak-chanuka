{
  "name": "seker-game",
  "version": "1.0.0",
  "scripts": {
    "build": "vite build && node scripts/build-assets.mjs",
    "dev:web": "vite",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute seker-game-db --local --file schema.sql"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20"
  },
  "type": "module"
}
